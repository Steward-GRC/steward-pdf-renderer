# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Operator (see docs/configuration.md)
RENDERER_IMAGE=registry.example.org/steward-pdf-renderer/renderer:dev
S3_SECRET_NAME=steward-pdf-renderer-s3
JOB_BACKOFF_LIMIT=3
JOB_TTL_SECONDS=600
JOB_SERVICE_ACCOUNT=steward-pdf-renderer
WATCH_NAMESPACE=steward
LEADER_ELECT=false
PROBE_PORT=8080
METRICS_PORT=9090

# Renderer, for running cmd/renderer by hand (the operator sets these on Jobs)
FETCH_URL=http://localhost:8081/versions/pv-example/html
OUTPUT_BUCKET=steward-artifacts
OUTPUT_KEY=artifacts/pv-example/example-render.pdf
PV_ID=pv-example
SENSITIVITY=standard
REQUESTED_BY=erin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FORCE_PATH_STYLE=true
# A local run has no projected token. In a Job the operator sets
# WORKLOAD_TOKEN_FILE instead.
WORKLOAD_AUTH=disabled
